# ============================================================
# EcoPin Image Validation — Classifier Service
# Example environment file
#
# Copy this file to .env and fill in the values.
# NEVER commit your actual .env file.
# ============================================================

# ---------------------------------------------------------------------------
# MODEL CONFIGURATION
# ---------------------------------------------------------------------------

# Path to the EfficientNet-B0 checkpoint.
# Default (relative to image_validation/):
#   checkpoints/exp8/best.pt   (Exp 8 — original ~350-image baseline)
#
# To use the final Experiment 02 model (recommended, trained on 1,000 images):
#   MODEL_CHECKPOINT_PATH=C:\dev\ecopin_ml_models\final_1000_dataset\experiments\experiment_02_baseline_finetune\best_model.pt
#
# On a teammate's machine, adjust this path to wherever they placed the checkpoint.
# MODEL_CHECKPOINT_PATH=

# Model architecture — do not change unless you swap the backbone.
# MODEL_NAME=efficientnet_b0

# Number of output classes — must match the checkpoint.
# NUM_CLASSES=4

# Comma-separated class names — order must match the training class index.
# CLASS_NAMES=flooding,non_environmental,pollution,waste

# Input image size in pixels (square). Must match training config.
# IMAGE_SIZE=224

# ---------------------------------------------------------------------------
# SERVER CONFIGURATION
# ---------------------------------------------------------------------------

# Host address. Use 127.0.0.1 for local-only access.
# HOST=127.0.0.1

# Port the classifier service listens on.
# PORT=8000

# Compute device. Use "cpu" for CPU inference (default, no GPU required).
# Use "cuda" to enable GPU inference if an NVIDIA GPU is available.
# DEVICE=cpu

# Maximum accepted request body size in bytes (default 20 MB).
# MAX_BODY_BYTES=20971520
